# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Keep .env itself out of version control (it's already in .gitignore, since
# it may hold Steam credentials below).
#
# This one file does two jobs: docker compose auto-reads it for ${VAR}
# interpolation in the compose files (ACEVO_VERSION, IMAGE_TAG), AND it's
# loaded via env_file into the running container (all variables below).

# --- Manager version ---------------------------------------------------------
# Currently active acevo-server-manager release (must match a folder under
# releases/). Change this (or better, use ./update.sh) to switch
# versions. Since the binary is mounted in at runtime rather than baked into
# the image, switching this only needs a restart - no rebuild/pull required:
#   docker compose up -d
ACEVO_VERSION=v1.6.3

# Tag of the published base image to pull for docker-compose.yml (the
# GHCR-based prod setup). Usually "latest" is fine; pin to a specific
# tooling release version (e.g. "1.0.0") if you want reproducible
# deployments.
IMAGE_TAG=latest

# Timezone the container (and therefore the manager's logs, scheduled
# events, etc.) actually uses - not just declared, it's applied to
# /etc/localtime on every start. Use an IANA zone name, e.g. Europe/Berlin,
# America/New_York, Asia/Tokyo. Defaults to UTC if left blank/unset.
TZ=UTC

# --- Game server download (steamcmd) -----------------------------------------
# Set to 1 to auto-download/update the game server via steamcmd on container
# start.
ACEVO_AUTO_UPDATE=1
ACEVO_STEAM_APPID=4564210

# Steam credentials - only needed if the default anonymous steamcmd login
# doesn't work for downloading the AC EVO dedicated server files (it usually
# does - see README-docker.md). Leave blank to use anonymous login.
# NOTE: if Steam Guard/2FA is enabled on this account, the first run needs
# to happen interactively: docker compose run --rm acevo-server-manager
STEAM_USER=
STEAM_PASS=
