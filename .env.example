# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Keep .env itself out of version control (it's already in .gitignore, since
# it may hold Steam credentials below).
#
# This one file does two jobs: docker compose auto-reads it for ${VAR}
# interpolation in the compose files (ACEVO_VERSION, IMAGE_TAG), AND it's
# loaded via env_file into the running container (all variables below).

# --- Manager version ---------------------------------------------------------
# Currently active acevo-server-manager release (must match a folder under
# releases/). Change this (or better, use ./acsm-evo-control.sh update-manager)
# to switch versions. Since the binary is mounted in at runtime rather than
# baked into the image, switching this only needs a restart - no rebuild/pull
# required:
#   docker compose up -d
ACEVO_VERSION=v1.6.3

# Tag of the published base image to pull for docker-compose.yml (the
# GHCR-based prod setup). Usually "latest" is fine; pin to a specific
# tooling release version (e.g. "v0.0.2" - matches the git tag exactly,
# "v" included) if you want reproducible deployments.
IMAGE_TAG=latest

# Timezone the container (and therefore the manager's logs, scheduled
# events, etc.) actually uses - not just declared, it's applied to
# /etc/localtime on every start. Use an IANA zone name, e.g. Europe/Berlin,
# America/New_York, Asia/Tokyo. Defaults to UTC if left blank/unset.
TZ=UTC

# --- Game server download (steamcmd) -----------------------------------------
# Set to 1 to auto-install the game server via steamcmd the first time the
# container starts (skipped on later restarts once it's installed - use
# ./acsm-evo-control.sh update-game to update it on demand after that).
ACEVO_AUTO_UPDATE=1
ACEVO_STEAM_APPID=4564210

# Steam credentials - REQUIRED. Anonymous login fails for this app. The
# account must own/have Assetto Corsa EVO in its library, even though
# you're only downloading the dedicated server tool - see README-docker.md.
# NOTE: if Steam Guard/2FA is enabled on this account, the first run needs
# to happen interactively: docker compose run --rm acevo-server-manager
STEAM_USER=
STEAM_PASS=

# --- Optional monitoring/alerting -------------------------------------------
# Pinged (fire-and-forget) on every successful container start - a
# Healthchecks.io or Uptime Kuma push URL, for example. Leave blank to skip.
HEARTBEAT_URL=

# Used by `acsm-evo-control.sh watch` to post a crash-loop alert. Expects a
# Discord-style webhook (POSTs {"content": "..."}). Leave blank to just
# print alerts to the terminal instead.
ALERT_WEBHOOK_URL=
